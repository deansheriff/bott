# ---------------------------------------------------------------------------
# Restaurant Chatwoot bot: environment configuration
# Copy to .env for local dev; set the same names in Coolify for production.
# Values marked (runtime-editable) are only initial defaults: once changed on
# /admin/settings the database value wins.
# ---------------------------------------------------------------------------

# production | development | test. Production refuses to boot with weak/missing secrets.
APP_ENV=development
RESTAURANT_NAME=Our Restaurant

# --- Chatwoot ---------------------------------------------------------------
# URL this service uses to call the Chatwoot API (server-to-server).
# Same Coolify server: the internal Docker network URL, e.g. http://chatwoot-web:3000
# Otherwise: the public URL, e.g. https://chat.example.com
CHATWOOT_BASE_URL=https://chat.example.com
# Browser-facing Chatwoot URL. Used for the Dashboard App iframe CSP (frame-ancestors)
# and the postMessage origin check. REQUIRED when CHATWOOT_BASE_URL is an internal URL.
CHATWOOT_PUBLIC_URL=https://chat.example.com
CHATWOOT_ACCOUNT_ID=1
# Agent bot access token (Settings > Integrations > Agent Bots). Sent as api_access_token.
CHATWOOT_BOT_TOKEN=
# Agent bot webhook signing secret (shown when the bot is created / on its edit form).
CHATWOOT_WEBHOOK_SECRET=

# --- LLM --------------------------------------------------------------------
# openai | fake (fake = offline, always hands off; for local testing only)
LLM_PROVIDER=openai
OPENAI_API_KEY=
# (runtime-editable)
LLM_MODEL=gpt-4o-mini
# (runtime-editable) at the cap the bot goes handoff-only
DAILY_LLM_SPEND_CAP_USD=5

# --- Storage ----------------------------------------------------------------
# Local dev: SQLite. Production: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./data/dev.db
KNOWLEDGE_DIR=./knowledge
MEDIA_DIR=./data/media
# Used only by docker-compose.yml for the bundled Postgres.
POSTGRES_PASSWORD=change-me-long-random

# --- Security ---------------------------------------------------------------
# 32+ random chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Fernet key for agents' Chatwoot tokens:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/rotating it means every agent must reconnect their Chatwoot token.
TOKEN_ENCRYPTION_KEY=
# First boot only: creates the admin, who must change the password at first login.
# Remove DASHBOARD_ADMIN_PASSWORD from the environment after first login.
DASHBOARD_ADMIN_EMAIL=owner@example.com
DASHBOARD_ADMIN_PASSWORD=
# Optional comma-separated IPs/CIDRs allowed to reach /admin/ (e.g. 203.0.113.10,10.0.0.0/8)
DASHBOARD_ALLOWED_IPS=
# Must be true in production (HTTPS). Set false only for local http://localhost dev.
COOKIE_SECURE=false
# Proxies whose X-Forwarded-For is trusted (uvicorn). "*" is fine only when the container
# port is NOT published and all traffic comes through Coolify's proxy.
FORWARDED_ALLOW_IPS=*

# --- Restaurant / operations ------------------------------------------------
# (runtime-editable)
TIMEZONE=Africa/Lagos
# per conversation
WEBHOOK_RATE_LIMIT_PER_MINUTE=12
LOG_LEVEL=INFO
# Local development only: inserts a sample menu, zones and hours. NEVER in production.
SEED_DEMO_DATA=false
